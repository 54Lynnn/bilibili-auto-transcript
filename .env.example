# ============================================================
# Bilibili Auto Transcript - 配置
# 复制此文件为 .env 并填入你的配置
# ============================================================

# ---- B站收藏夹 ----
# 收藏夹ID（从收藏夹URL ?fid= 后的数字获取）
FAV_MEDIA_ID=

# ---- AI 摘要（可选） ----
# 支持任何 OpenAI 兼容 API（DeepSeek、OpenCode Go、OpenRouter 等）
#
# 示例配置：
#
# --- DeepSeek 官方 ---
# OPENAI_API_KEY=sk-xxx
# SUMMARY_API_URL=https://api.deepseek.com
# SUMMARY_API_MODEL=deepseek-v4-flash
#
# --- OpenCode Go ---
# OPENAI_API_KEY=sk-xxx
# SUMMARY_API_URL=https://opencode.ai/zen/go/v1/chat/completions
# SUMMARY_API_MODEL=deepseek-v4-flash
#
# --- OpenAI 官方 ---
# OPENAI_API_KEY=sk-xxx
# SUMMARY_API_MODEL=gpt-4o-mini
#
# --- 任何 OpenAI 兼容 API ---
# OPENAI_API_KEY=your-key-here
# SUMMARY_API_URL=https://your-api-provider.com/v1/chat/completions
# SUMMARY_API_MODEL=your-model-name

OPENAI_API_KEY=
# SUMMARY_API_URL=https://api.openai.com/v1/chat/completions  # 取消注释并改为你用的API地址
SUMMARY_API_MODEL=gpt-4o-mini
